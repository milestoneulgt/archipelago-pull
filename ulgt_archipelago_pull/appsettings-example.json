{
  "ArchipelagoApi": {
    "BaseUrl": "https://api.onarchipelago.com",
    "AuthDomain": "archipelago-analytics.auth0.com",
    "ClientId":"{prod-clientId}",
    "ClientSecret": "{prod-client-secret}",
    "Audience": "https://api.onarchipelago.com/v1",
    "OrganizationName": "Utah Local Governments Trust"
  },
  "ArchipelagoStageApi": {
    "BaseUrl": "https://api-staging.onarchipelago.com",
    "AuthDomain": "archipelago-staging.auth0.com",
    "ClientId": "{stage-clientId}",
    "ClientSecret": "{stage-clientSecret}",
    "Audience": "https://api.staging.onarchipelago.com/v1",
    "OrganizationName": "Utah Trust - Staging API Integration Testing"
  },  
    "Logging": {
        "FilePath": "logs/app.log",
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning"
        }
    },
    "ArchipelagoReadSettings": {
        "Environment": 1, // 1 means production, other wise stage
        "IsEnabled": true,
        "IntervalSeconds": 0,
        "EffectiveFrom": "2025-06-01T00:00:00Z",
        "IsFirstRunCheckActive": true, // If active, perform check
        "SqlDatabase": "Server=localhost;User Id=archapp;Password={db-password};Initial Catalog=archipelagoStaging;Encrypt=True;TrustServerCertificate=True;",
        "PageSize": 200,
        "IsPropertyLossRetrievalEnabled": false
    } 
}